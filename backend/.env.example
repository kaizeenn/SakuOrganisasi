# Backend environment variables — copy to .env and adjust
# Server
PORT=9000
NODE_ENV=production
CORS_ORIGIN=*

# Database (MySQL)
DATABASE_URL="mysql://root@localhost:3306/saku_organisasi"

# Auth
JWT_SECRET=ganti-dengan-string-acak-yang-panjang-dan-rahasia
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Seed admin default (dipakai saat `npm run db:seed`)
SEED_ADMIN_NAME=Bendahara Utama
SEED_ADMIN_USERNAME=iril
SEED_ADMIN_PASSWORD=ganti-password-kuat
